# Public browser configuration. Never use a Supabase service-role/secret key here.
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# Configure these only as Supabase Edge Function secrets. Do not add them to Netlify.
SUPABASE_SERVICE_ROLE_KEY=SUPABASE_SERVICE_ROLE_KEY_CONFIGURE_IN_SUPABASE_ONLY
ALLOWED_ORIGINS=https://YOUR_NETLIFY_SITE.netlify.app
IP_GEOLOCATION_URL=https://YOUR_IP_PROVIDER_ENDPOINT
IP_GEOLOCATION_API_KEY=YOUR_IP_PROVIDER_API_KEY
